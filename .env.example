# Copy to .env.local. Never commit real secrets.
# Local values are printed by `npx supabase start` (or `npx supabase status -o env`).

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- AI (optional) — any OpenAI-compatible endpoint (Groq, OpenRouter, Gemini, Ollama…) ---
# "none" = no AI: the app uses the built-in exercise library.
AI_PROVIDER=none
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Optional cost tracking (USD per million tokens); free tiers: leave 0.
AI_PRICE_INPUT_PER_MTOK_USD=0
AI_PRICE_OUTPUT_PER_MTOK_USD=0

# --- Stripe (optional; TEST mode keys until launch) — see docs/BILLING.md ---
# Without STRIPE_SECRET_KEY the app shows "payment not enabled" (never a fake payment).
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook`
STRIPE_WEBHOOK_SECRET=
